{
  "name": "dsh-permission-no-confirm",
  "version": "1.0.0",
  "private": true,
  "description": "Switch DeepSeek Harness permission modes without the Full access / Auto review risk-confirmation modal.",
  "license": "MIT",
  "author": "Magixyne <42512131@smail.swufe.edu.cn>",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "permission",
    "web-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SwufeFox/dsh-permission-no-confirm.git"
  },
  "homepage": "https://github.com/SwufeFox/dsh-permission-no-confirm#readme",
  "bugs": {
    "url": "https://github.com/SwufeFox/dsh-permission-no-confirm/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test test/client.test.mjs"
  }
}
